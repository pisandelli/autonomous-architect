@layer base
  *, *::before, *::after
    box-sizing: border-box

  *
    margin: 0

  html, body
    min-block-size: 100dvh

  body
    line-height: 1.5
    -webkit-font-smoothing: antialiased
    font-family: var(--font-body, 'Inter', system-ui, -apple-system, sans-serif)
    background-color: var(--bg-app, #f9fafb) /* fallback: gray-50 */
    color: var(--text-main, #111827)          /* fallback: gray-900 */

  img, picture, video, canvas, svg
    display: block
    max-inline-size: 100%
    block-size: auto /* Preserve aspect ratio */

  input, button, textarea, select
    font: inherit

    overflow-wrap: break-word
  
  p, li, dd, dt, figcaption
    text-wrap: pretty

  h1, h2, h3, h4, h5, h6
    text-wrap: balance

  #prefix-app, #__nuxt
    isolation: isolate
